PORT=8080
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Optional DB config
DB_VENDOR=postgres
DB_DSN=postgres://user:pass@localhost:5432/sursangam?sslmode=disable

# Optional Razorpay config
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Per-client request limits (requests/window). Set RATE_LIMIT_ENABLED=false to disable.
RATE_LIMIT_ENABLED=true
# Set to a single client-IP header only when your trusted proxy overwrites it.
# For Render, use CF-Connecting-IP; otherwise leave empty to use the direct peer IP.
RATE_LIMIT_CLIENT_IP_HEADER=
RATE_LIMIT_ADMIN_LOGIN=5/15m
RATE_LIMIT_CUSTOMER_LOGIN=10/15m
RATE_LIMIT_CUSTOMER_REGISTER=5/1h
RATE_LIMIT_PASSWORD_RESET=3/1h
RATE_LIMIT_PASSWORD_UPDATE=5/15m
RATE_LIMIT_CHECKOUT=20/1m
RATE_LIMIT_RAZORPAY_ORDER=10/1m
RATE_LIMIT_COUPON_USE=10/1m
RATE_LIMIT_INQUIRY=5/1h
